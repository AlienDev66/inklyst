{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@pagina/domain": ["./packages/domain/src/index.ts"],
      "@pagina/supabase": ["./packages/supabase/src/index.ts"]
    }
  },
  "include": ["src", "packages"],
  "exclude": ["packages/**/*.test.ts", "node_modules", "dist"]
}
